rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate notification schema
    function isValidNotification() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'schemaVersion', 'timestamp', 'title', 'packageName', 'sourceDeviceId'])
        && data.title is string
        && data.title.size() <= 500
        && data.packageName is string
        && data.schemaVersion is string;
    }
    
    // Helper function to validate device registration
    function isValidDevice() {
      let data = request.resource.data;
      return data.keys().hasAll(['type', 'fcmToken', 'deviceName', 'lastSeen', 'createdAt'])
        && data.type in ['android', 'watchos']
        && data.fcmToken is string
        && data.fcmToken.size() > 0;
    }
    
    // Users collection
    match /users/{userId} {
      // Allow authenticated users to read/write their own profile
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // Users cannot delete their profile
      
      // Profile subcollection
      match /profile/{document=**} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
      
      // Devices subcollection
      match /devices/{deviceId} {
        // Allow authenticated users to manage their own devices
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDevice();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        // Allow authenticated users to read their notifications
        allow read: if isOwner(userId);
        
        // Only allow create from authenticated owner with valid schema
        allow create: if isOwner(userId) && isValidNotification();
        
        // Allow update for marking as read/processed
        allow update: if isOwner(userId);
        
        // Allow deletion for cleanup
        allow delete: if isOwner(userId);
      }
    }
    
    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
